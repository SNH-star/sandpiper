            version=config['SANDPIPER_VERSION']))
    log:
        '{test_or_prod}/{version}/backend_db/create_taxonomies_name_lower_idx_.log'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    resources:
        runtime='4h'
    shell:
        'export SNAKE_WORKING_DIR=`pwd` && ' \
        'export PYTHONNOUSERSITE=1 && ' \
        'cd ../backend && ' \
        'pixi run -e sandpiper python -c "import duckdb; con = duckdb.connect(\'db/sandpiper_{config[SANDPIPER_VERSION]}.duckdb\'); con.execute(\'DROP INDEX IF EXISTS taxonomies_name_lower_idx\'); con.execute(\'CREATE INDEX taxonomies_name_lower_idx ON taxonomies (lower(name))\'); con.close()" &> $SNAKE_WORKING_DIR/{log}'

# --skip-* flags for export_indicpiper_and_metalog_csv.py, one per
# independent INCLUDE_*_CSV toggle in prod_config.yml.
EXPORT_CSV_SKIP_FLAGS = ' '.join(filter(None, [
    '' if config.get('INCLUDE_INDICPIPER_CSV', True) else '--skip-indicpiper',
    '' if config.get('INCLUDE_METALOG_CSV', True) else '--skip-metalog',
]))

rule export_indicpiper_and_metalog_csv:
    # Flat CSV exports of the finished database's IndicPiper habitat results
    # and metalog extended metadata, for consumption outside the
    # database/API. See backend/bin/export_indicpiper_and_metalog_csv.py.
    input:
        '{test_or_prod}/{version}/backend_db/taxonomies_name_lower_idx_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    output:
        touch('{test_or_prod}/{version}/backend_db/export_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION']))
    log:
        '{test_or_prod}/{version}/backend_db/export.log'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    params:
        # exports/ is a sibling of backend_db/, not nested inside it -- kept
        # out of api.dockerfile's `COPY backend /sandpiper` (which only
        # copies backend/, not snakemake/), and clearly separated from the
        # pipeline's own internal done-markers/logs.
        output_dir='{test_or_prod}/{version}/exports'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION']),
        skip_flags=EXPORT_CSV_SKIP_FLAGS
    resources:
        mem_mb=16000,
        runtime='2h'
    shell:
        'export SNAKE_WORKING_DIR=`pwd` && ' \
        'export PYTHONNOUSERSITE=1 && ' \
        'cd ../backend && ' \
        'pixi run -e sandpiper ./bin/export_indicpiper_and_metalog_csv.py ' \
        'db/sandpiper_{config[SANDPIPER_VERSION]}.duckdb ' \
        '$SNAKE_WORKING_DIR/{params.output_dir} ' \
        '{params.skip_flags} ' \
        '> $SNAKE_WORKING_DIR/{log} 2>&1'


##### Statistics page figures #####
# Two independent rules, neither needs the database, so each can be run alone at
# any time, e.g.
#   snakemake --cores 1 --configfile prod_config.yml statistics_groups
#   snakemake --cores 1 --configfile prod_config.yml statistics_versions
#   snakemake --cores 1 --configfile prod_config.yml statistics      (both)
# (add --forcerun summarise_group_figures to rebuild after changing an input).
# Each writes into {test_or_prod}/{version}/statistics/ and copies the file into
# vue/src/constants/, where the page imports it; rebuild the frontend after.

rule summarise_group_figures:
    # Yearly known-species trend, phylum composition and yearly depth for the
    # Statistics page. Streams the whole condensed table, so it is slow.
    input:
        summary=config['SMF_FILE'],
        condensed=config['CONDENSED_OTU_TABLE'],
        parsed_metadata=KINGFISHER_DIR + '/parsed_metadata.tsv',
        gtdb_metadata=config['GTDB_GENOME_METADATA'],
        blacklist=RUN_BLACKLIST,
    output:
        STATISTICS_DIR + '/groupSummaries.json'
    params:
        script=os.path.join(BACKEND_BIN, 'summarise_groups.py'),
        chunk_dir=KINGFISHER_DIR + '/metadata_chunks',
        frontend=os.path.join(STATISTICS_FRONTEND_DIR, 'groupSummaries.json'),
    log:
        STATISTICS_DIR + '/groupSummaries.log'
    resources:
        mem_mb=32000,
        runtime='8h'
    shell:
        'export PYTHONNOUSERSITE=1 && '
        'pixi run -e sandpiper python {params.script} {output} {input.blacklist} '
        '{input.summary} {input.parsed_metadata} {params.chunk_dir} {input.condensed} '
        '{input.gtdb_metadata} > {log} 2>&1 && '
        'cp {output} {params.frontend}'

rule summarise_version_figures:
    # Histograms comparing this build with earlier releases (version comparison).
    input:
        summary=config['SMF_FILE'],
        parsed_metadata=KINGFISHER_DIR + '/parsed_metadata.tsv',
        previous=[spec.split(':')[2] for spec in config['STATISTICS_PREVIOUS_VERSIONS']]
                 + [spec.split(':')[3] for spec in config['STATISTICS_PREVIOUS_VERSIONS']],
        blacklist=RUN_BLACKLIST,
    output:
        STATISTICS_DIR + '/versionSummaries.json'
    params:
        script=os.path.join(BACKEND_BIN, 'summarise_versions.py'),
        # Newest first: this build, then the earlier releases.
        specs=lambda wildcards, input: [
            '{}:{}:{}:{}'.format(config['STATISTICS_VERSION_LABEL'], config['STATISTICS_GTDB_RELEASE'],
                                 input.summary, input.parsed_metadata)
        ] + list(config['STATISTICS_PREVIOUS_VERSIONS']),
        frontend=os.path.join(STATISTICS_FRONTEND_DIR, 'versionSummaries.json'),
    log:
        STATISTICS_DIR + '/versionSummaries.log'
    resources:
        mem_mb=16000,
        runtime='2h'
    shell:
        'export PYTHONNOUSERSITE=1 && '
        'pixi run -e sandpiper python {params.script} {output} {input.blacklist} '
        '{params.specs:q} > {log} 2>&1 && '
        'cp {output} {params.frontend}'

# Named targets so the figures can be built on their own (they are also in `all`).
rule statistics_groups:
    input: STATISTICS_DIR + '/groupSummaries.json'

rule statistics_versions:
    input: STATISTICS_DIR + '/versionSummaries.json'

rule statistics:
    input: rules.statistics_groups.input, rules.statistics_versions.input
