        # Raised from 17h after the v40 build was KILLED at exactly 17h04m
        # (job 24645044, 2026-08-04) with no traceback -- PBS walltime, not a
        # code error. It had processed all 910k samples and written 277M
        # condensed profile rows (48 min just to commit those), and had only
        # just reached "Committing known species fractions" when time ran out.
        # Note the parent orchestrator job still had 24h of its 48h spare --
        # each rule is its own PBS job, so THIS value is the binding limit.
        runtime='48h'
    shell:
