##### accessions in 50k chunks for kingfisher metadata scalbility #####
import csv
import glob
import itertools
import os
import re

file_list = config['ACCESSIONS_FILE']

# The kingfisher / bioproject pulls below query NCBI for ~1M accessions. Without
# a real key NCBI throttles to a third of the rate. The key is never stored in
# this repo: pass it at launch with  --config NCBI_API_KEY=$NCBI_API_KEY
if config.get('NCBI_API_KEY', '').startswith('YOUR_NCBI_API_KEY'):
    print("WARNING: NCBI_API_KEY is still the placeholder -- the metadata pull will be slow and may be throttled. "
          "Launch with --config NCBI_API_KEY=<your key>")

# Whether the fetch_metalog/join_metalog_metadata rules below regenerate the
# metalog meta_ column extension from scratch each build (fresh download +
# join against this build's raw kingfisher_metadata.tsv), or the pipeline
# behaves exactly as it did before the metalog extension existed. Same
# explicit-boolean shape as INCLUDE_INDICPIPER below.
INCLUDE_METALOG = config.get('INCLUDE_METALOG', True)

# Whether the add_indicpiper_scores_to_backend_db rule below runs its real
# --stage indicpiper call, or just copies the db forward unchanged. Explicit
# boolean (unlike METALOG_EXTENSION_METADATA's presence/absence toggle) since
# the IndicPiper submodule is always present in the checkout even when
# temporarily disabling this stage.
INCLUDE_INDICPIPER = config.get('INCLUDE_INDICPIPER', True)

# Process this many in the list at a time.
chunk_size = 10000

# Read the list of files to process into a list
paths = []
with open(file_list) as f:
    reader = csv.reader(f, delimiter='\t')
    for row in reader:
        paths.append(row[0])

# Convert them into chunks
def iterable_chunks(iterable, n):
    '''Given an iterable, return it in chunks of size n. In the last chunk, the
    remaining space is replaced by None entries.
    '''
    args = [iter(iterable)] * n
    return itertools.zip_longest(*args, fillvalue=None)
chunked_genome_lists = []
for chunk in iterable_chunks(paths, chunk_size):
    chunked_genome_lists.append(list([a for a in chunk if a is not None]))

print("Kingfisher annotate will process {} accessions in {} chunks of size {}".format(len(paths), len(chunked_genome_lists), chunk_size))
if not os.path.exists('data/chunk_definitions'):
    os.makedirs('data/chunk_definitions')
if not os.path.exists('data/chunk_definitions.done'):
    print("Writing chunk definition files")
    for i, chunk in enumerate(chunked_genome_lists):
        with open('data/chunk_definitions/{}.txt'.format(i), 'w') as f:
            f.write('\n'.join(chunk))
    print("Finished writing chunk definition files")
    with open('data/chunk_definitions.done', 'w') as f:
        f.write('')
else:
    print("Chunk definition files already exist, reusing them")

STATISTICS_DIR = '{test_or_prod}/{version}/statistics'.format(
    test_or_prod=config['TEST_OR_PROD'], version=config['SANDPIPER_VERSION'])
KINGFISHER_DIR = '{test_or_prod}/kingfisher_metadata/{date}'.format(
    test_or_prod=config['TEST_OR_PROD'], date=config['KINGFISHER_METADATA_DATE'])
# Where the Statistics page imports its figures from.
STATISTICS_FRONTEND_DIR = os.path.join(workflow.basedir, '..', 'vue', 'src', 'constants')
BACKEND_BIN = os.path.join(workflow.basedir, '..', 'backend', 'bin')
RUN_BLACKLIST = os.path.join(workflow.basedir, '..', 'backend', 'db', 'metagenome_assembly_acc_list.csv')

localrules: run_kingfisher_metadata, gather_kingfisher_metadata, gather_bioproject_pubs


