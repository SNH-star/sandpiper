rule generate_backend_db_stage2:
    input:
        done = '{test_or_prod}/{version}/backend_db/taxonomy_upload_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION']),
        bioproject_publications='{test_or_prod}/process_bioproject_pubs/{date}/bioproject_publications.csv'.format(
            date=config['BIOPROJECT_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        bioproject_done='{test_or_prod}/gather_bioproject_pubs/{date}/done'.format(
            date=config['BIOPROJECT_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        kingfisher_metadata_file_list='{test_or_prod}/kingfisher_metadata/{date}/kingfisher_metadata_file_list'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        kingfisher_done='{test_or_prod}/kingfisher_metadata/{date}/done'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
    log:
        '{test_or_prod}/{version}/backend_db/stage2.log'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    output:
        done = touch('{test_or_prod}/{version}/backend_db/stage2_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION']))
    params:
        describe=os.path.abspath(config['METAPACKAGE_DESCRIBE']),
    benchmark:
        'backend_db/{test_or_prod}/{version}/stage2.txt'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    resources:
        mem_mb=128000,
        # Raised from 17h after the v40 build was KILLED at exactly 17h04m
        # (job 24645044, 2026-08-04) with no traceback -- PBS walltime, not a
        # code error. It had processed all 910k samples and written 277M
        # condensed profile rows (48 min just to commit those), and had only
        # just reached "Committing known species fractions" when time ran out.
        # Note the parent orchestrator job still had 24h of its 48h spare --
        # each rule is its own PBS job, so THIS value is the binding limit.
        runtime='48h'
    shell:
        'export SNAKE_WORKING_DIR=`pwd` && ' \
        'export PYTHONNOUSERSITE=1 && ' \
        'cd ../backend && ' \
        'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.after_taxonomy_upload {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb && ' \
        'pixi run -e sandpiper ./bin/generate_backend_db --stage stage2 --run-blacklist db/metagenome_assembly_acc_list.csv --condensed-otu-table {config[CONDENSED_OTU_TABLE]} --globdb-condensed-otu-table {config[GLOBDB_CONDENSED_OTU_TABLE]} -o {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb --host-predictions-tsv {config[HOST_OR_NOT_PREDICTION]} --bioproject-associated-publications $SNAKE_WORKING_DIR/{input.bioproject_publications} --smf-file {config[SMF_FILE]} 2> $SNAKE_WORKING_DIR/{log} && ' \
        'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.after_stage2'

rule add_tags_to_backend_db:
    input:
        '{test_or_prod}/{version}/backend_db/stage2_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    output:
        touch('{test_or_prod}/{version}/backend_db/tags_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION']))
    log:
        '{test_or_prod}/{version}/backend_db/tags.log'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    shell:
        'export SNAKE_WORKING_DIR=`pwd` && ' \
        'export PYTHONNOUSERSITE=1 && ' \
        'cd ../backend && ' \
        # cp to remain idempotent, e.g. if this step fails
        'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.after_stage2 {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb && ' \
        'pixi run -e sandpiper ./bin/generate_backend_db --stage tags -o {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb 2> $SNAKE_WORKING_DIR/{log} && ' \
        'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.after_tags'

