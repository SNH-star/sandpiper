            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    resources:
        runtime='6h',
        mem_mb = 128 * 1024, # Failed with 8g, I think maybe just want this to work for now, can adjust by benchmark later.
    benchmark:
        'backend_db/{test_or_prod}/{version}/cache_table.txt'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    shell:
        'export SNAKE_WORKING_DIR=`pwd` && ' \
        'export PYTHONNOUSERSITE=1 && ' \
