rule generate_parsed_metadata_from_kingfisher:
    input:
        file_list='{test_or_prod}/kingfisher_metadata/{date}/kingfisher_metadata_file_list'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD'])
    output:
        parsed_metadata='{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata.tsv'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        done=touch('{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata_done'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD'])),
    resources:
        mem_mb=32000,
        runtime='1h'
    log:
        '{test_or_prod}/kingfisher_metadata/{date}/logs/kingfisher_metadata_parsed.log'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD'])
    shell:
        'pixi run -e sandpiper ../backend/sandpiper/parse_biosample_extras.py --kingfisher-annotate-tsv-list {input.file_list} --extra-sample-keys depth temperature collection_date > {output.parsed_metadata} 2> {log}'

# Per-version scratch dir for the regenerated metalog download + join -- keeps
# this build's files out of metalog_custom/ (and out of any other checkout), so
# nothing here collides with a manual run or a differently versioned build.
METALOG_OUTPUT_DIR = '{scratch}/metalog/{version}'.format(
    scratch=config['SCRATCH_DIR'], version=config['SANDPIPER_VERSION'])
METALOG_DOWNLOAD_DIR = '{}/downloads'.format(METALOG_OUTPUT_DIR)
METALOG_SLIM_OUTPUT = '{}/kingfisher_metadata_meta_slim.tsv'.format(METALOG_OUTPUT_DIR)

# Resolved metalog extension path used by extend_parsed_metadata_with_metalog
# below: the fresh join output when INCLUDE_METALOG, empty (pass-through)
# otherwise -- same presence/absence toggle extend_parsed_metadata.py always
# expected, just computed instead of read from a static config path.
METALOG_EXTENSION_METADATA = METALOG_SLIM_OUTPUT if INCLUDE_METALOG else ''

if INCLUDE_METALOG:
    rule fetch_metalog:
        # Downloads Metalog's "_latest" extended-wide files fresh every run
        # (see metalog_custom/scripts/fetch_metalog.py) -- these are stable
        # URLs that redirect to whatever the current dated release is, so
        # this genuinely re-fetches from scratch each build rather than
        # reusing a cached copy. Requires outbound internet access from
        # wherever this rule executes (verify the aqua profile's compute
        # nodes can reach metalog.embl.de before relying on this).
        output:
            touch('{test_or_prod}/{version}/backend_db/metalog_fetch_done'.format(
                test_or_prod=config['TEST_OR_PROD'],
                version=config['SANDPIPER_VERSION']))
        log:
            '{test_or_prod}/{version}/backend_db/metalog_fetch.log'.format(
                test_or_prod=config['TEST_OR_PROD'],
                version=config['SANDPIPER_VERSION'])
        params:
            download_dir=METALOG_DOWNLOAD_DIR
        resources:
            mem_mb=4000,
            runtime='30m'
        shell:
            'export SNAKE_WORKING_DIR=`pwd` && ' \
            'export PYTHONNOUSERSITE=1 && ' \
            'cd ../metalog_custom && ' \
            'pixi run -e sandpiper python scripts/fetch_metalog.py --config config.yml ' \
            '--download-dir {params.download_dir} ' \
            '> $SNAKE_WORKING_DIR/{log} 2>&1'

    rule join_metalog_metadata:
        # Joins the freshly fetched metalog files onto the kingfisher metadata
        # this same build has just pulled (the per-chunk files listed in
        # kingfisher_metadata_file_list), so the metalog columns always match
        # the metadata the database is loaded with. Each chunk has its own
        # column set, hence slim output only (run + meta_ columns).
        # Writes into a version-scoped scratch dir so concurrent builds of
        # different SANDPIPER_VERSIONs can't collide.
        input:
            fetch_done='{test_or_prod}/{version}/backend_db/metalog_fetch_done'.format(
                test_or_prod=config['TEST_OR_PROD'],
                version=config['SANDPIPER_VERSION']),
            kingfisher_file_list='{test_or_prod}/kingfisher_metadata/{date}/kingfisher_metadata_file_list'.format(
                date=config['KINGFISHER_METADATA_DATE'],
                test_or_prod=config['TEST_OR_PROD']),
            kingfisher_done='{test_or_prod}/kingfisher_metadata/{date}/done'.format(
                date=config['KINGFISHER_METADATA_DATE'],
                test_or_prod=config['TEST_OR_PROD'])
        output:
            slim=METALOG_SLIM_OUTPUT
        log:
            '{test_or_prod}/{version}/backend_db/metalog_join.log'.format(
                test_or_prod=config['TEST_OR_PROD'],
                version=config['SANDPIPER_VERSION'])
        params:
            output_dir=METALOG_OUTPUT_DIR,
            download_dir=METALOG_DOWNLOAD_DIR,
            kingfisher_file_list=lambda wildcards, input: os.path.abspath(input.kingfisher_file_list)
        resources:
            mem_mb=32000,
            runtime='2h'
        shell:
            'export SNAKE_WORKING_DIR=`pwd` && ' \
            'export PYTHONNOUSERSITE=1 && ' \
            'mkdir -p {params.output_dir} && ' \
            'cd ../metalog_custom && ' \
            'pixi run -e sandpiper python scripts/join_metadata.py --config config.yml ' \
            '--kingfisher-metadata-list {params.kingfisher_file_list} ' \
            '--download-dir {params.download_dir} ' \
            '--output-dir {params.output_dir} ' \
            '--slim-only ' \
            '> $SNAKE_WORKING_DIR/{log} 2>&1'

rule extend_parsed_metadata_with_metalog:
    # Append metalog meta_ columns onto parsed_metadata (joined by run). If
    # INCLUDE_METALOG is false, parsed metadata is passed through unchanged,
    # so downstream behaviour is identical to before the metalog extension
    # existed.
    input:
        parsed_metadata='{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata.tsv'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        done='{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata_done'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        metalog_slim=(METALOG_SLIM_OUTPUT if INCLUDE_METALOG else []),
    output:
        extended='{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata_extended.tsv'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        provenance='{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata_extended.tsv.metalog_provenance.json'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        done=touch('{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata_extended_done'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD'])),
    params:
        ext_flag=('--metalog-extension ' + METALOG_EXTENSION_METADATA) if METALOG_EXTENSION_METADATA else '',
    resources:
        mem_mb=16000,
        runtime='1h'
    log:
        '{test_or_prod}/kingfisher_metadata/{date}/logs/parsed_metadata_extended.log'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD'])
    shell:
        'pixi run -e sandpiper ../backend/sandpiper/extend_parsed_metadata.py '
        '--parsed-metadata {input.parsed_metadata} {params.ext_flag} '
        '--output {output.extended} 2> {log}'

rule add_parsed_metadata_from_kingfisher:
    input:
        parsed_metadata='{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata_extended.tsv'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        metalog_provenance='{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata_extended.tsv.metalog_provenance.json'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        done='{test_or_prod}/kingfisher_metadata/{date}/parsed_metadata_extended_done'.format(
            date=config['KINGFISHER_METADATA_DATE'],
            test_or_prod=config['TEST_OR_PROD']),
        # After OTUs because then it can be changed up until the last minute
        # done_db='{test_or_prod}/{version}/backend_db/otus_done'.format(
        #     test_or_prod=config['TEST_OR_PROD'],
        #     version=config['SANDPIPER_VERSION'])
        # After OTUs because then it can be changed up until the last minute 
        done_db='{test_or_prod}/{version}/backend_db/tags_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    resources:
        mem_mb=64000,
        runtime='17h'
    output:
        done=touch('{test_or_prod}/{version}/backend_db/parsed_metadata_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])),
    log:
        '{test_or_prod}/{version}/backend_db/parsed_metadata.log'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    params:
        # abspath to input.parsed_metadata
        parsed_metadata=lambda wildcards, input: os.path.abspath(input.parsed_metadata),
        metalog_provenance=lambda wildcards, input: os.path.abspath(input.metalog_provenance),
    shell:
        'export SNAKE_WORKING_DIR=`pwd` && ' \
        'export PYTHONNOUSERSITE=1 && ' \
        'cd ../backend && ' \
        # cp to remain idempotent, e.g. if this step fails
        'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.after_tags {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.add_parsed_metadata_from_kingfisher && ' \
        # cp the otus because scratch will be faster than /work/microbiome (didn't end up being any faster)
        # 'cp {config[OTU_TABLE]} {config[SCRATCH_DIR]}/otus && ' \
        'pixi run -e sandpiper ./bin/generate_backend_db --stage parsed_metadata --parsed-metadata-table {params.parsed_metadata} --metalog-provenance {params.metalog_provenance} -o {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.add_parsed_metadata_from_kingfisher 2> $SNAKE_WORKING_DIR/{log} && ' \
        'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.add_parsed_metadata_from_kingfisher db/'

def _resolve_indicpiper_csv():
    """Highest-numbered genus_habitat_indicators_v*.csv shipped by the
    IndicPiper submodule (indicpiper_custom/IndicPiper/, see
    https://github.com/cliffbueno/IndicPiper). IndicPiper's own curated
    13-habitat indicator database is used as-is -- Sandpiper no longer
    regenerates its own indicator set from Sandpiper's own data. Picking up
    a future submodule release (e.g. a new v3.csv) needs no Snakefile edit,
    only `git submodule update --remote indicpiper_custom/IndicPiper` +
    commit.
    """
    submodule_dir = os.path.join(workflow.basedir, '..', 'indicpiper_custom', 'IndicPiper')
    candidates = glob.glob(os.path.join(submodule_dir, 'genus_habitat_indicators_v*.csv'))
    if not candidates:
        raise Exception(
            "No genus_habitat_indicators_v*.csv found in the IndicPiper submodule "
            "({}) -- is the submodule checked out? Run: "
            "git submodule update --init indicpiper_custom/IndicPiper".format(submodule_dir))

    def version_key(path):
        m = re.search(r'_v(\d+)\.csv$', path)
        return int(m.group(1)) if m else -1

    return max(candidates, key=version_key)

INDICPIPER_CSV = _resolve_indicpiper_csv() if INCLUDE_INDICPIPER else None

rule add_indicpiper_scores_to_backend_db:
    input:
        parsed_metadata_done='{test_or_prod}/{version}/backend_db/parsed_metadata_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION']),
    output:
        touch('{test_or_prod}/{version}/backend_db/indicpiper_done'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION']))
    log:
        '{test_or_prod}/{version}/backend_db/indicpiper.log'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    params:
        indicpiper_csv=INDICPIPER_CSV
    resources:
        mem_mb=64000,
        runtime='24h'
    benchmark:
        'backend_db/{test_or_prod}/{version}/indicpiper.txt'.format(
            test_or_prod=config['TEST_OR_PROD'],
            version=config['SANDPIPER_VERSION'])
    shell:
        (
            # INCLUDE_INDICPIPER: false -- copy the db forward unchanged, same
            # "false reproduces today's exact DB" contract as every other
            # optional stage in this pipeline.
            'export SNAKE_WORKING_DIR=`pwd` && ' \
            'export PYTHONNOUSERSITE=1 && ' \
            'cd ../backend && ' \
            'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.add_parsed_metadata_from_kingfisher {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.after_indicpiper 2> $SNAKE_WORKING_DIR/{log}'
            if not INCLUDE_INDICPIPER else
            'export SNAKE_WORKING_DIR=`pwd` && ' \
            'export PYTHONNOUSERSITE=1 && ' \
            'cd ../backend && ' \
            'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.add_parsed_metadata_from_kingfisher {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb && ' \
            'pixi run -e sandpiper ./bin/generate_backend_db --stage indicpiper --indicpiper-csv {params.indicpiper_csv} -o {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb 2> $SNAKE_WORKING_DIR/{log} && ' \
            'cp {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb {config[SCRATCH_DIR]}/sandpiper_{config[SANDPIPER_VERSION]}.duckdb.after_indicpiper'
        )

